rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHomeworkAssignment(data) {
      return data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.subject is string && data.subject.size() <= 80
        && data.grade is string && data.grade.size() <= 80
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128
        && data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 150
        && data.mode in ['class', 'open_link']
        && data.status in ['active', 'closed']
        && data.questions is list && data.questions.size() > 0 && data.questions.size() <= 100
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 300
        && data.allowRetake is bool
        && data.showAnswersAfterSubmit is bool
        && (!('antiCheatMode' in data) || data.antiCheatMode in ['none', 'shuffle_original', 'variants_and_shuffle'])
        && (!('shuffleQuestions' in data) || data.shuffleQuestions is bool)
        && (!('shuffleOptions' in data) || data.shuffleOptions is bool)
        && (!('variantCount' in data) || (data.variantCount is number && data.variantCount >= 1 && data.variantCount <= 6))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 6))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidHomeworkSubmission(data, assignmentId) {
      return data.id is string && isValidId(data.id)
        && data.assignmentId == assignmentId
        && data.studentAuthUid is string && data.studentAuthUid.size() > 0 && data.studentAuthUid.size() <= 128
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150
        && (!('studentRosterId' in data) || (data.studentRosterId is string && data.studentRosterId.size() <= 128))
        && (!('studentClassName' in data) || (data.studentClassName is string && data.studentClassName.size() <= 80))
        && (!('variantCode' in data) || (data.variantCode is string && data.variantCode.size() <= 32))
        && (!('variantLabel' in data) || (data.variantLabel is string && data.variantLabel.size() <= 80))
        && (!('shuffleSeed' in data) || (data.shuffleSeed is number && data.shuffleSeed >= 0))
        && data.attemptNumber is number && data.attemptNumber >= 1 && data.attemptNumber <= 100
        && data.answers is map
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 10
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 100
        && data.wrongCount is number && data.wrongCount >= 0 && data.wrongCount <= 100
        && data.totalQuestions is number && data.totalQuestions > 0 && data.totalQuestions <= 100
        && data.totalTimeSeconds is number && data.totalTimeSeconds >= 0 && data.totalTimeSeconds <= 86400
        && data.questionDetails is list && data.questionDetails.size() <= 100
        && data.activityLog is list && data.activityLog.size() <= 500
        && data.startedAt is string && data.startedAt.size() <= 64
        && data.submittedAt is string && data.submittedAt.size() <= 64;
    }

    // Connection check document for Firestore SDK health probe
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Collections for cross-device sync across classroom smartboards and teacher devices
    match /global_store/{document=**} {
      allow read, write: if true;
    }
    match /smartboard_lessons_col/{lessonId} {
      allow read, write: if true;
    }
    match /TaiLieuGiaoVien/{docId} {
      allow read, write: if true;
    }
    match /files/{fileId}/{document=**} {
      allow read, write: if true;
    }
    match /file_chunks/{chunkId} {
      allow read, write: if true;
    }
    match /lectures/{lectureId} {
      allow read, write: if true;
    }
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /boardStates/{boardId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isValidTeacherQuizBank(data, teacherId) {
      return data.teacherId == teacherId
        && data.items is list && data.items.size() <= 500
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Per-teacher private quiz & game repository (strictly scoped by teacherId, never listable)
    match /teacher_saved_quizzes/{teacherId} {
      allow get: if isAuthenticated() && isValidId(teacherId);
      allow list: if false;
      allow create: if isAuthenticated() && isValidId(teacherId) && isValidTeacherQuizBank(request.resource.data, teacherId);
      allow update: if isAuthenticated() && isValidId(teacherId) && isValidTeacherQuizBank(request.resource.data, teacherId);
      allow delete: if isAuthenticated() && isValidId(teacherId);
    }

    // Homework Assignments & Student Submissions (Đề online theo lớp hoặc link tự do)
    match /homework_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId);
      allow list: if resource.data.teacherId is string && resource.data.teacherId.size() > 0;
      allow create: if isValidId(assignmentId) && isValidHomeworkAssignment(request.resource.data);
      allow update: if isValidId(assignmentId) && isValidHomeworkAssignment(request.resource.data);
      allow delete: if isValidId(assignmentId);

      match /submissions/{submissionId} {
        allow get, list: if isValidId(assignmentId);
        allow create: if isValidId(assignmentId) && isValidId(submissionId) && isValidHomeworkSubmission(request.resource.data, assignmentId);
        allow update: if isValidId(assignmentId) && isValidId(submissionId) && isValidHomeworkSubmission(request.resource.data, assignmentId);
        allow delete: if isValidId(assignmentId) && isValidId(submissionId);
      }
    }

    // Catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
